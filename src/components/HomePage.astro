---
import { VisualEditing } from '@sanity/astro/visual-editing';

import '../styles/global.css';
import type { Locale } from '../lib/sanity/locale';
import { pickLocale } from '../lib/sanity/locale';
import type { IntlArray } from '../lib/sanity/queries';
import { isPreview } from '../lib/sanity/preview';
import { getHomeContent } from '../lib/sanity/getHomeContent';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const preview = isPreview(Astro.cookies);
const content = await getHomeContent(preview);

const t = (field: IntlArray | undefined) => pickLocale(field, locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/lexend-latin.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>Somi</title>
  </head>
  <body>
  <header class="site-nav">
    <a class="site-nav__wordmark" href="/" aria-label="Somi"><Logo /></a>
    <nav aria-label={{ ca: 'Navegació principal', es: 'Navegación principal', en: 'Main navigation' }[locale]}>
      <ul class="site-nav__links">
        <li><a class="site-nav__link" href="#ethos">Ethos</a></li>
        <li><a class="site-nav__link" href="#activities">Activitats</a></li>
        <li><a class="site-nav__link" href="#residency">Residència</a></li>
        <li><a class="site-nav__link" href="#join">Uneix-te</a></li>
        <li><a class="site-nav__link" href="#about">Sobre</a></li>
      </ul>
    </nav>
    <div class="site-nav__right">
      <nav aria-label={{ ca: 'Idioma', es: 'Idioma', en: 'Language' }[locale]}>
        <ul class="locale-switcher">
          <li><a class="locale-switcher__link" href="/"   lang="ca" hreflang="ca" aria-current={locale === 'ca' ? 'page' : undefined}>cat</a></li>
          <li><a class="locale-switcher__link" href="/es" lang="es" hreflang="es" aria-current={locale === 'es' ? 'page' : undefined}>es</a></li>
          <li><a class="locale-switcher__link" href="/en" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>en</a></li>
        </ul>
      </nav>
    </div>
  </header>
    <main>
      <section id="hero" class="hero">
          <p class="hero__tagline">{t(content?.hero?.tagline)}</p>
          <h1>{t(content?.hero?.heading)}</h1>
          <p class="prose-col whitespace-pre-line">{t(content?.hero?.lede)}</p>
        </section>

      <section id="ethos" class="page-wrap py-section">
        <h2>{t(content?.ethos?.heading)}</h2>
        <p class="prose-col whitespace-pre-line">{t(content?.ethos?.body)}</p>
      </section>

      <section id="activities" class="page-wrap py-section">
        <h2>{t(content?.activities?.heading)}</h2>
        <p class="prose-col whitespace-pre-line">{t(content?.activities?.body)}</p>
        <p data-cta>{t(content?.activities?.cta)}</p>
      </section>

      <section id="join" class="page-wrap py-section">
        <h2>{t(content?.join?.heading)}</h2>
        <p class="prose-col whitespace-pre-line">{t(content?.join?.body)}</p>
        <p data-cta>{t(content?.join?.cta)}</p>
      </section>

      <section id="residency" class="page-wrap py-section">
        <h2>{t(content?.residency?.heading)}</h2>
        <p class="prose-col whitespace-pre-line">{t(content?.residency?.body)}</p>
      </section>

      <section id="about" class="page-wrap py-section">
        <h2>{t(content?.about?.heading)}</h2>
        <p class="prose-col whitespace-pre-line">{t(content?.about?.body)}</p>
      </section>
    </main>

    {preview && <a href="/api/draft-mode/disable">Exit preview</a>}
    <VisualEditing enabled={preview} />
  </body>
</html>
